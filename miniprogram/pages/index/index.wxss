.index-page {
  padding-top: 12rpx;
}

/* 头部 */
.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 8rpx 4rpx 20rpx;
}

.date {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.streak {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--gold);
}
.streak.muted {
  color: var(--text-faint);
}
.flame { margin-right: 4rpx; }

.header-right {
  display: flex;
  gap: 20rpx;
  padding-top: 10rpx;
}
.icon-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: var(--card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

/* 昨日复盘卡片 */
.review-card {
  background: linear-gradient(135deg, rgba(232, 180, 75, 0.14), rgba(232, 180, 75, 0.04));
  border: 1rpx solid rgba(232, 180, 75, 0.28);
  border-radius: 20rpx;
  padding: 22rpx 26rpx;
  margin: 8rpx 0 20rpx;
  animation: fadeUp 0.3s ease;
}
.review-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.review-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--gold);
}
.review-close {
  font-size: 26rpx;
  color: var(--text-faint);
  padding: 4rpx 12rpx;
}
.review-body {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--text-dim);
  word-break: break-word;
}
.review-foot {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-faint);
}

/* 今日概览 */
.today-bar {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 16rpx 6rpx;
  font-size: 26rpx;
  color: var(--text-dim);
}
.today-bar .count {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--gold);
  margin: 0 4rpx;
}
.today-bar .hint {
  font-size: 22rpx;
  color: var(--text-faint);
}

/* 舞台区 */
.stage {
  min-height: 340rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stage-empty {
  text-align: center;
}
.stage-empty .quote {
  font-size: 30rpx;
  color: var(--text-faint);
  line-height: 1.9;
  letter-spacing: 2rpx;
}

/* 录音中转写 */
.transcript {
  width: 100%;
  padding: 28rpx 30rpx;
  background: var(--card);
  border-radius: 24rpx;
  min-height: 200rpx;
  box-sizing: border-box;
}
.live-head {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--gold);
  margin-bottom: 16rpx;
}
.live-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--gold);
  margin-right: 12rpx;
  animation: blink 1s ease-in-out infinite;
}
@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.25; }
}
.spin {
  width: 24rpx;
  height: 24rpx;
  margin-right: 12rpx;
  border: 4rpx solid rgba(232, 180, 75, 0.25);
  border-top-color: var(--gold);
  border-radius: 50%;
  animation: rotate 0.8s linear infinite;
}
@keyframes rotate {
  to { transform: rotate(360deg); }
}
.live-text {
  font-size: 30rpx;
  line-height: 1.7;
  color: var(--text);
  min-height: 120rpx;
}

/* 已保存卡片 */
.saved {
  width: 100%;
  background: var(--card);
  border-radius: 24rpx;
  padding: 26rpx 30rpx 20rpx;
  box-sizing: border-box;
  animation: fadeUp 0.3s ease;
}
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.saved-head { margin-bottom: 12rpx; }
.saved-badge {
  display: inline-block;
  font-size: 22rpx;
  color: var(--text-faint);
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
}
.saved-badge.done {
  color: var(--gold);
  background: rgba(232, 180, 75, 0.12);
}
.saved-text {
  font-size: 32rpx;
  line-height: 1.65;
}
.saved-meta {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
}
.saved-actions {
  margin-top: 20rpx;
  text-align: right;
}
.ghost-btn {
  display: inline-block;
  font-size: 24rpx;
  color: var(--text-faint);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--text-faint);
}

/* 麦克风区域 */
.mic-area {
  display: flex;
  justify-content: center;
  padding: 40rpx 0 56rpx;
}

/* 时间线 */
.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-dim);
  padding: 10rpx 6rpx 18rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}
.section-title .more {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--gold);
}
.timeline {
  margin-top: 20rpx;
}
