.group {
  padding: 10rpx 30rpx;
}

/* 模式选择项 */
.mode-item {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}
.mode-item:last-of-type {
  border-bottom: none;
}
.mode-item radio {
  transform: scale(0.9);
  margin-top: 6rpx;
}
.mode-body {
  flex: 1;
  margin-left: 16rpx;
}
.mode-name {
  font-size: 30rpx;
  font-weight: 600;
}
.mode-desc {
  font-size: 24rpx;
  color: var(--text-faint);
  margin-top: 8rpx;
  line-height: 1.7;
}
.mode-desc.warn {
  color: var(--gold);
}
.mode-desc.ok {
  color: var(--teal);
}

/* Key 配置 */
.none-note {
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  font-size: 24rpx;
  color: var(--text-faint);
  line-height: 1.7;
}

.key-block {
  padding: 26rpx 0 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}
.own-status {
  margin-bottom: 4rpx;
}
.key-actions {
  display: flex;
  margin-top: 20rpx;
}
.key-actions .btn {
  flex: 1;
}
.key-actions .btn + .btn {
  margin-left: 20rpx;
}

/* 隐私说明 */
.privacy-note {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: var(--text-faint);
  line-height: 1.7;
}

.dev-note {
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}
.dev-status {
  font-size: 26rpx;
  color: var(--gold);
}
.dev-status.ok {
  color: var(--teal);
}
.consent-btn {
  width: 100%;
  margin: 20rpx 0 4rpx;
  box-sizing: border-box;
}

/* 开关行 */
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
}
.switch-body {
  flex: 1;
  padding-right: 20rpx;
}
.subscribe-btn {
  width: 100%;
  margin: 8rpx 0 16rpx;
  box-sizing: border-box;
}

/* 数据行 */
.row {
  padding: 22rpx 0;
  font-size: 28rpx;
}
.row.danger {
  color: var(--danger);
}

/* 关于 */
.about {
  text-align: center;
  padding: 60rpx 0 20rpx;
}
.about-title {
  font-size: 26rpx;
  color: var(--text-dim);
}
.about-desc {
  font-size: 22rpx;
  color: var(--text-faint);
  margin-top: 10rpx;
  line-height: 1.7;
}
