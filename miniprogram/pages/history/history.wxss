.history-page {
  padding-top: 12rpx;
}

/* 统计卡 */
.stats-card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 26rpx 28rpx 20rpx;
  margin-bottom: 24rpx;
}
.stats-row {
  display: flex;
}
.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--gold);
}
.stat-label {
  font-size: 22rpx;
  color: var(--text-faint);
  margin-top: 6rpx;
}

/* 热力图：GitHub 式标注（顶部月份 + 左侧周几） */
.heat-wrap {
  margin-top: 24rpx;
}
.heat-months {
  display: flex;
  padding-left: 50rpx;
  margin-bottom: 8rpx;
}
.heat-month {
  flex: 1;
  margin-right: 10rpx;
  height: 24rpx;
  line-height: 24rpx;
  font-size: 18rpx;
  color: var(--text-faint);
  white-space: nowrap;
}
.heat-body {
  display: flex;
}
.heat-weeks {
  flex-shrink: 0;
  width: 40rpx;
  margin-right: 10rpx;
}
.heat-week {
  height: 24rpx;
  line-height: 24rpx;
  font-size: 18rpx;
  color: var(--text-faint);
}
/* 行距 = 两行色块的步进（24 高 + 10 间距 ×2） */
.heat-week.gap {
  margin-top: 44rpx;
}
.heat-cols {
  flex: 1;
  display: flex;
  overflow: hidden;
}
.heat-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-right: 10rpx;
}
.heat-col:last-child {
  margin-right: 0;
}
.heat-cell {
  width: 100%;
  height: 24rpx;
  border-radius: 5rpx;
  margin-bottom: 10rpx;
  background: rgba(232, 180, 75, 0.07);
}
/* 浮窗选中态：金色描边 */
.heat-cell.on {
  box-shadow: 0 0 0 3rpx rgba(232, 180, 75, 0.8);
}

/* 轻点浮窗：fixed 定位在指尖上方 */
.heat-tip {
  position: fixed;
  z-index: 60;
  transform: translate(-50%, -100%);
  background: #262A33;
  border: 1rpx solid rgba(232, 180, 75, 0.45);
  color: var(--text);
  font-size: 22rpx;
  padding: 12rpx 22rpx;
  border-radius: 12rpx;
  white-space: nowrap;
  animation: tipIn 0.18s ease;
  margin-top: -14rpx; /* 与色块留一点空隙 */
}
.heat-tip::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -10rpx;
  transform: translateX(-50%);
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 10rpx solid #262A33;
}
@keyframes tipIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
.heat-cell.blank {
  background: transparent;
}
.heat-cell.lv-1 { background: rgba(232, 180, 75, 0.28); }
.heat-cell.lv-2 { background: rgba(232, 180, 75, 0.55); }
.heat-cell.lv-3 { background: var(--gold); }
.heat-legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 12rpx;
  font-size: 20rpx;
  color: var(--text-faint);
}
.heat-legend .heat-cell {
  width: 14rpx;
  height: 14rpx;
  margin: 0 4rpx 0 8rpx;
}

/* 搜索 + 类型筛选 */
.search-bar {
  margin-bottom: 24rpx;
}
.search-box {
  display: flex;
  align-items: center;
  background: var(--card);
  border-radius: 999rpx;
  padding: 6rpx 24rpx;
}
.search-input {
  flex: 1;
  font-size: 26rpx;
  min-height: 68rpx;
}
.search-ph {
  color: var(--text-faint);
}
.search-clear {
  color: var(--text-faint);
  font-size: 26rpx;
  padding: 10rpx 4rpx 10rpx 20rpx;
}
.type-chips {
  display: flex;
  margin-top: 16rpx;
}
.tchip {
  font-size: 24rpx;
  color: var(--text-dim);
  background: var(--card);
  border-radius: 999rpx;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
}
.tchip.on {
  color: #14161A;
  font-weight: 600;
  background: var(--gold);
}

.day-group {
  margin-bottom: 30rpx;
}

/* 长按弹出的删除按钮 */
.h-item {
  position: relative;
}
.h-del {
  position: absolute;
  top: 16rpx;
  right: 22rpx;
  background: var(--danger);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  padding: 10rpx 30rpx;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 24rpx rgba(240, 102, 110, 0.35);
  opacity: 0;
  transform: scale(0.8);
  transition: opacity 0.15s ease, transform 0.15s ease;
  pointer-events: none;
  z-index: 5;
}
.h-del.show {
  opacity: 1;
  transform: scale(1);
  pointer-events: auto;
}

.day-head {
  font-size: 26rpx;
  color: var(--text-dim);
  font-weight: 600;
  padding: 8rpx 6rpx 16rpx;
}
