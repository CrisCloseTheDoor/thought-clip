<view class="page detail-page" wx:if="{{entry}}">

  <!-- 声音灵感视图 -->
  <block wx:if="{{isVoice}}">
    <view class="card detail-head">
      <view class="type-row">
        <view class="v-kind">♪ 声音灵感</view>
        <text class="time">{{entry.timeText}}</text>
      </view>
      <view class="v-big-title" bindtap="renameInspire">
        <text>{{entry.title || '声音灵感'}}</text>
        <text class="v-rename-hint">轻点重命名</text>
      </view>
      <view class="v-amps {{voicePlaying ? 'playing' : ''}}">
        <view class="v-amp-bar" wx:for="{{entry.ampsView}}" wx:key="index"
          style="height: {{item.v}}%; animation-delay: {{item.d}}s"></view>
      </view>
      <view class="v-ctrl">
        <view class="v-play-big {{voicePlaying ? 'playing' : ''}}" bindtap="toggleVoicePlay"></view>
        <text class="v-dur-text">{{voicePlaying ? '正在播放' : '点击回听'}}{{entry.duration ? ' · ' + entry.duration + 's' : ''}}</text>
      </view>
    </view>

    <view class="action-row">
      <view class="action" bindtap="renameInspire">重命名</view>
      <view class="action" bindtap="exportInspireAudio">导出音频</view>
      <view class="action danger" bindtap="deleteEntry">删除</view>
    </view>
  </block>

  <!-- 普通记录视图 -->
  <block wx:else>

  <!-- 主卡片 -->
  <view class="card detail-head">
    <view class="type-row">
      <text class="type-tag" style="background: {{entry.typeColor}}1F; color: {{entry.typeColor}};">{{entry.typeLabel}}</text>
      <text class="time">{{entry.timeText}}</text>
    </view>

    <!-- 展示态 -->
    <block wx:if="{{!editing}}">
      <view class="detail-text">{{entry.text}}</view>
      <view class="keywords" wx:if="{{entry.keywords && entry.keywords.length}}">
        <text class="chip" wx:for="{{entry.keywords}}" wx:key="*this">#{{item}}</text>
      </view>
      <view class="edited-tag" wx:if="{{entry.edited}}">（已手动编辑）</view>
    </block>

    <!-- 编辑态 -->
    <block wx:else>
      <textarea
        class="edit-area"
        value="{{editText}}"
        bindinput="onEditInput"
        maxlength="-1"
        auto-height
      />
      <view class="edit-actions">
        <view class="btn btn-ghost" bindtap="cancelEdit">取消</view>
        <view class="btn btn-primary" bindtap="saveEdit">保存</view>
      </view>
    </block>
  </view>

  <!-- 原始转写对比 -->
  <view class="card raw-card" wx:if="{{entry.raw && entry.raw !== entry.text}}">
    <view class="raw-head" bindtap="toggleRaw">
      <text>原始转写（AI 整理前）</text>
      <text class="arrow">{{showRaw ? '收起 ▾' : '展开 ▸'}}</text>
    </view>
    <view class="raw-body" wx:if="{{showRaw}}">{{entry.raw}}</view>
  </view>

  <!-- 你想获得什么反馈？：按需内容反馈 -->
  <view class="card fb-card">
    <view class="fb-head">
      <text>你想获得什么反馈？</text>
      <text class="fb-hint">按需反馈 · 随记录留存</text>
    </view>
    <view class="fb-chips">
      <view class="fb-chip {{item.k === 'companion' ? 'companion' : ''}}"
        wx:for="{{fbChips}}" wx:key="k" bindtap="askFeedback" data-kind="{{item.k}}">{{item.label}}</view>
    </view>
    <view class="fb-loading" wx:if="{{fbLoading}}">正在思考…（约数秒）</view>
    <view class="fb-empty" wx:elif="{{!feedbacks.length}}">选一个，几秒后回来收反馈；不满意可删除重来</view>
    <view class="fb-list" wx:else>
      <view class="fb-item {{item.kind === 'companion' ? 'companion' : ''}}"
        wx:for="{{feedbacks}}" wx:key="id">
        <view class="fb-meta">
          <text class="fb-kind">{{item.label}}</text>
          <view class="fb-right">
            <text class="fb-time">{{item.timeText}}</text>
            <view class="fb-del" catchtap="deleteFeedback" data-ts="{{item.id}}">✕</view>
          </view>
        </view>
        <view class="fb-text">{{item.text}}</view>
      </view>
    </view>
  </view>

  <!-- 保留的原声 -->
  <view class="card voice-card" wx:if="{{voices.length}}">
    <view class="voice-title">原声</view>
    <view class="voice-row {{playingVoice === item.fileID ? 'playing' : ''}}" wx:for="{{voices}}"
      wx:key="fileID" bindtap="playVoice" data-file="{{item.fileID}}">
      <view class="voice-play"></view>
      <text class="voice-label">{{item.label}}</text>
      <text class="voice-state">{{playingVoice === item.fileID ? '正在播放' : '点击回听'}}</text>
    </view>
  </view>

  <!-- 操作 -->
  <view class="action-row">
    <view class="action" bindtap="copyText">{{editing ? '复制当前' : '复制'}}</view>
    <view class="action" bindtap="startEdit" wx:if="{{!editing}}">编辑</view>
    <view class="action danger" bindtap="deleteEntry">删除</view>
  </view>
  </block>

</view>
