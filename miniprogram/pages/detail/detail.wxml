<view class="page detail-page" wx:if="{{entry}}">

  <!-- 声音灵感视图 -->
  <block wx:if="{{isVoice}}">
    <view class="card detail-head">
      <view class="type-row">
        <view class="v-kind">♪ 声音灵感</view>
        <text class="time">{{entry.timeText}}</text>
      </view>
      <view class="v-big-title" bindtap="renameInspire">
        <text>{{entry.title || '声音灵感'}}</text>
        <text class="v-rename-hint">轻点重命名</text>
      </view>
      <view class="v-amps {{voicePlaying ? 'playing' : ''}}">
        <view class="v-amp-bar" wx:for="{{entry.ampsView}}" wx:key="index"
          style="height: {{item.v}}%; animation-delay: {{item.d}}s"></view>
      </view>
      <view class="v-ctrl">
        <view class="v-play-big {{voicePlaying ? 'playing' : ''}}" bindtap="toggleVoicePlay"></view>
        <text class="v-dur-text">{{voicePlaying ? '正在播放' : '点击回听'}}{{entry.duration ? ' · ' + entry.duration + 's' : ''}}</text>
      </view>
    </view>

    <view class="action-row">
      <view class="action" bindtap="renameInspire">重命名</view>
      <view class="action" bindtap="exportInspireAudio">导出音频</view>
      <view class="action danger" bindtap="deleteEntry">删除</view>
    </view>
  </block>

  <!-- 普通记录视图 -->
  <block wx:else>

  <!-- 主卡片 -->
  <view class="card detail-head">
    <view class="type-row">
      <text class="type-tag" style="background: {{entry.typeColor}}1F; color: {{entry.typeColor}};">{{entry.typeLabel}}</text>
      <text class="time">{{entry.timeText}}</text>
    </view>

    <!-- 展示态 -->
    <block wx:if="{{!editing}}">
      <view class="detail-text">{{entry.text}}</view>
      <view class="keywords" wx:if="{{entry.keywords && entry.keywords.length}}">
        <text class="chip" wx:for="{{entry.keywords}}" wx:key="*this">#{{item}}</text>
      </view>
      <view class="edited-tag" wx:if="{{entry.edited}}">（已手动编辑）</view>
    </block>

    <!-- 编辑态 -->
    <block wx:else>
      <textarea
        class="edit-area"
        value="{{editText}}"
        bindinput="onEditInput"
        maxlength="-1"
        auto-height
      />
      <view class="edit-actions">
        <view class="btn btn-ghost" bindtap="cancelEdit">取消</view>
        <view class="btn btn-primary" bindtap="saveEdit">保存</view>
      </view>
    </block>
  </view>

  <!-- 原始转写对比 -->
  <view class="card raw-card" wx:if="{{entry.raw && entry.raw !== entry.text}}">
    <view class="raw-head" bindtap="toggleRaw">
      <text>原始转写（AI 整理前）</text>
      <text class="arrow">{{showRaw ? '收起 ▾' : '展开 ▸'}}</text>
    </view>
    <view class="raw-body" wx:if="{{showRaw}}">{{entry.raw}}</view>
  </view>

  <!-- 你想获得什么反馈？：按需内容反馈 -->
  <view class="card fb-card">
    <view class="fb-head">
      <text>你想获得什么反馈？</text>
      <text class="fb-hint">按需反馈 · 随记录留存</text>
    </view>

    <view class="fb-chips">
      <view class="fb-chip {{fbTab === item.k ? 'on' : ''}} {{item.k === 'companion' ? 'companion' : ''}}"
        wx:for="{{fbChips}}" wx:key="k" bindtap="onChipTap" data-kind="{{item.k}}">{{item.label}}</view>
    </view>

    <!-- 历史上下文开关（全局，置于反馈类型下方） -->
    <view class="ctx-row" bindtap="onCtxToggle">
      <view class="ctx-body">
        <view class="ctx-name">允许检索历史上下文</view>
        <view class="ctx-desc">{{ctxEnabled ? '已开启 · 回答将参考相关历史记录' : '推荐开启 · 需同意'}}</view>
      </view>
      <view class="toggle {{ctxEnabled ? 'on' : ''}}">
        <view class="toggle-knob"></view>
      </view>
    </view>

    <!-- 已有对话：视角锁定最新——思考动效与追问输入置顶，历史在下方滑窗内滚动 -->
    <block wx:if="{{fbHasAny}}">
      <view class="fb-thinking" wx:if="{{fbLoading}}">
        <view class="tdot"></view>
        <view class="tdot d2"></view>
        <view class="tdot d3"></view>
        <text class="fb-thinking-text">正在思考…</text>
      </view>
      <view class="fb-follow" style="margin-top: 16rpx;">
        <input class="fb-follow-input" value="{{followText}}" placeholder="继续追问…"
          placeholder-class="compose-ph" confirm-type="send" bindinput="onFollowInput" bindconfirm="sendFollowUp" />
        <view class="fb-send {{fbLoading || !followText ? 'off' : ''}}" bindtap="sendFollowUp">发送</view>
      </view>
      <scroll-view scroll-y class="fb-scroll" scroll-into-view="{{fbScrollInto}}">
          <block wx:for="{{fbView}}" wx:key="key">
            <view wx:if="{{item.type === 'gdel'}}" class="fb-gdel" catchtap="deleteThread">删除对话</view>
            <!-- 用户追问：右侧气泡，气泡内文字左对齐 -->
            <view wx:elif="{{item.user}}" class="fb-me" id="t{{item.id}}">
              <view class="fb-me-bubble">{{item.text}}</view>
              <view class="fb-me-meta">
                <text class="fb-time">{{item.timeText}}</text>
                <view class="fb-del" catchtap="deleteTurn" data-ts="{{item.id}}">✕</view>
              </view>
            </view>
            <view wx:else class="fb-item {{item.kind === 'companion' ? 'companion' : ''}}" id="t{{item.id}}">
              <view class="fb-meta">
                <text class="fb-kind">{{item.label}}</text>
                <view class="fb-right">
                  <text class="fb-time">{{item.timeText}}</text>
                  <view class="fb-del" catchtap="deleteTurn" data-ts="{{item.id}}">✕</view>
                </view>
              </view>
              <view class="fb-text">{{item.text}}</view>
              <view class="fb-sources" wx:if="{{item.sources.length}}">
                <text class="fb-src-hint">参考贴纸：</text>
                <view class="fb-src" wx:for="{{item.sources}}" wx:for-item="s" wx:key="id"
                  catchtap="goSource" data-id="{{s.id}}">
                  <text class="fb-src-n">[{{s.n}}]</text>
                  <text class="fb-src-date">{{s.label}}</text>
                  <text class="fb-src-snip">{{s.snippet}}</text>
                </view>
              </view>
            </view>
          </block>
          <view class="fb-empty" wx:if="{{!fbView.length}}">该类别暂无对话</view>
        </scroll-view>
    </block>
    <!-- 首次反馈：无对话可保持，显示整块加载 -->
    <view class="fb-loading" wx:elif="{{fbLoading}}">{{ctxEnabled ? '正在检索历史上下文，为您生成更有质量的回答…' : '正在思考…（约数秒）'}}</view>
    <view class="fb-empty" wx:else>选一个，几秒后回来收反馈；不满意可删除重来</view>
  </view>

  <!-- 保留的原声 -->
  <view class="card voice-card" wx:if="{{voices.length}}">
    <view class="voice-title">原声</view>
    <view class="voice-row {{playingVoice === item.fileID ? 'playing' : ''}}" wx:for="{{voices}}"
      wx:key="fileID" bindtap="playVoice" data-file="{{item.fileID}}">
      <view class="voice-play"></view>
      <text class="voice-label">{{item.label}}</text>
      <text class="voice-state">{{playingVoice === item.fileID ? '正在播放' : '点击回听'}}</text>
    </view>
  </view>

  <!-- 操作 -->
  <view class="action-row">
    <view class="action" bindtap="copyText">{{editing ? '复制当前' : '复制'}}</view>
    <view class="action" bindtap="startEdit" wx:if="{{!editing}}">编辑</view>
    <view class="action danger" bindtap="deleteEntry">删除</view>
  </view>
  </block>

</view>
