.detail-page {
  padding-top: 12rpx;
}

.detail-head {
  padding: 30rpx 32rpx;
}

.type-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.type-tag {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
}
.time {
  font-size: 24rpx;
  color: var(--text-faint);
}

.detail-text {
  font-size: 34rpx;
  line-height: 1.7;
  word-break: break-word;
}

.keywords {
  margin-top: 20rpx;
}
.edited-tag {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--text-faint);
}

/* 编辑态 */
.edit-area {
  width: 100%;
  min-height: 160rpx;
  font-size: 32rpx;
  line-height: 1.7;
  color: var(--text);
  background: var(--card-2);
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
}
.edit-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}
.edit-actions .btn {
  padding: 14rpx 36rpx;
  font-size: 26rpx;
  margin-left: 20rpx;
}

/* ---- 声音灵感 ---- */
.v-kind {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--teal);
  background: rgba(79, 209, 197, 0.12);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}
.v-big-title {
  margin-top: 22rpx;
}
.v-big-title text:first-child {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.4;
  word-break: break-word;
}
.v-rename-hint {
  display: block;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-faint);
  margin-top: 10rpx;
}
.v-amps {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 200rpx;
  background: var(--card-2);
  border-radius: 16rpx;
  margin-top: 30rpx;
  padding: 0 26rpx;
  overflow: hidden;
}
.v-amp-bar {
  flex: 1;
  min-height: 8rpx;
  max-width: 20rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, rgba(79, 209, 197, 0.85), rgba(79, 209, 197, 0.45));
}
/* 播放中：柱子错峰起伏 */
.v-amps.playing .v-amp-bar {
  animation: ampWave 0.8s ease-in-out infinite alternate;
}
@keyframes ampWave {
  from { transform: scaleY(1); }
  to { transform: scaleY(0.5); }
}
.v-ctrl {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
}
.v-play-big {
  position: relative;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: rgba(79, 209, 197, 0.14);
  border: 1rpx solid rgba(79, 209, 197, 0.5);
  flex-shrink: 0;
}
.v-play-big::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-40%, -50%); /* 三角形光学居中：略右偏 */
  border-left: 24rpx solid var(--teal);
  border-top: 16rpx solid transparent;
  border-bottom: 16rpx solid transparent;
}
.v-play-big.playing::after {
  transform: translate(-50%, -50%);
  width: 8rpx;
  height: 32rpx;
  border-left: 8rpx solid var(--teal);
  border-right: 8rpx solid var(--teal);
  border-top: none;
  border-bottom: none;
  box-sizing: content-box;
}
.v-dur-text {
  margin-left: 24rpx;
  font-size: 24rpx;
  color: var(--text-dim);
}

/* 保留的原声 */
.voice-card {
  margin-top: 24rpx;
  padding: 22rpx 30rpx;
}
.voice-title {
  font-size: 26rpx;
  color: var(--text-dim);
}
.voice-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  background: var(--card-2);
  border-radius: 14rpx;
  padding: 16rpx 22rpx;
}
.voice-play {
  position: relative;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(232, 180, 75, 0.16);
  border: 1rpx solid rgba(232, 180, 75, 0.4);
  flex-shrink: 0;
}
.voice-play::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-40%, -50%); /* 三角形光学居中：略右偏 */
  border-left: 16rpx solid var(--gold);
  border-top: 11rpx solid transparent;
  border-bottom: 11rpx solid transparent;
}
.voice-row.playing .voice-play::after {
  transform: translate(-50%, -50%);
  width: 6rpx;
  height: 22rpx;
  border-left: 6rpx solid var(--gold);
  border-right: 6rpx solid var(--gold);
  border-top: none;
  border-bottom: none;
  box-sizing: content-box;
}
.voice-label {
  margin-left: 18rpx;
  font-size: 26rpx;
}
.voice-state {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--text-faint);
}

/* 原始转写 */
.raw-card {
  margin-top: 24rpx;
  padding: 22rpx 30rpx;
}
.raw-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  color: var(--text-dim);
}
.raw-head .arrow {
  color: var(--gold);
  font-size: 24rpx;
}
.raw-body {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--text-faint);
  line-height: 1.7;
  word-break: break-word;
}

/* 操作 */
.action-row {
  display: flex;
  margin-top: 40rpx;
}
.action {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  background: var(--card);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--text-dim);
}
.action + .action {
  margin-left: 20rpx;
}
.action.danger {
  color: var(--danger);
}
