.entry-card {
  position: relative;
  background: var(--card);
  border-radius: 24rpx;
  padding: 26rpx 28rpx 24rpx 36rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.entry-card:active {
  background: var(--card-2);
}

.type-bar {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
}

/* ---- 思维模式周复盘变体：温暖舒适风格 ---- */
.type-bar.weekly {
  background: #D4866E;
}
.weekly-card {
  background: linear-gradient(135deg, rgba(212, 134, 110, 0.12), rgba(212, 134, 110, 0.03)), var(--card);
  border: 1rpx solid rgba(212, 134, 110, 0.25);
}
.w-head {
  display: flex;
  align-items: center;
}
.w-badge {
  font-size: 22rpx;
  font-weight: 600;
  color: #E8A088;
  background: rgba(212, 134, 110, 0.14);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}
.w-text {
  font-size: 28rpx;
  line-height: 1.7;
  margin-top: 16rpx;
  word-break: break-word;
  white-space: pre-line;
  color: var(--text-dim);
}

/* ---- 密码贴纸变体：温暖色调 ---- */
.type-bar.pwd {
  background: #9B8EC4;
}
.hidden-card {
  background: linear-gradient(135deg, rgba(155, 142, 196, 0.08), rgba(155, 142, 196, 0.03)), var(--card);
  border: 1rpx solid rgba(155, 142, 196, 0.2);
}
.pwd-row {
  display: flex;
  align-items: center;
}
.pwd-icon {
  margin-right: 10rpx;
  font-size: 26rpx;
}
.pwd-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #9B8EC4;
}
.pwd-title {
  font-size: 26rpx;
  color: var(--text-dim);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-top: 8rpx;
}

/* ---- 声音灵感变体 ---- */
.type-bar.music {
  background: var(--teal);
}
.v-head {
  display: flex;
  align-items: center;
}
.v-badge {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--teal);
  background: rgba(79, 209, 197, 0.12);
  border-radius: 8rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
}
.v-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.v-dur {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--text-faint);
}
.v-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.v-bars {
  flex: 1;
  min-width: 0;
  height: 56rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
  overflow: hidden;
}
.v-bar {
  flex: 1;
  min-height: 6rpx;
  max-width: 14rpx;
  border-radius: 3rpx;
  background: rgba(79, 209, 197, 0.65);
}
/* 播放中：柱子按 8 根一循环错峰起伏，均衡器式动效 */
.v-bars.playing .v-bar {
  animation: vbarWave 0.8s ease-in-out infinite alternate;
}
@keyframes vbarWave {
  from { transform: scaleY(1); }
  to { transform: scaleY(0.5); }
}
.v-play {
  position: relative;
  flex-shrink: 0;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(79, 209, 197, 0.14);
  border: 1rpx solid rgba(79, 209, 197, 0.45);
  margin-left: 20rpx;
}
.v-play::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-40%, -50%); /* 三角形光学居中：略右偏 */
  border-left: 16rpx solid var(--teal);
  border-top: 11rpx solid transparent;
  border-bottom: 11rpx solid transparent;
}
.v-play.playing::after {
  transform: translate(-50%, -50%);
  width: 6rpx;
  height: 22rpx;
  border-left: 6rpx solid var(--teal);
  border-right: 6rpx solid var(--teal);
  border-top: none;
  border-bottom: none;
  box-sizing: content-box;
}

.text {
  font-size: 30rpx;
  line-height: 1.65;
  word-break: break-word;
  white-space: pre-line; /* 编辑时手打的换行符正常显示为分段 */
}

.raw {
  margin-top: 14rpx;
  padding: 16rpx 20rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: var(--text-faint);
}

.meta {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.type-chip {
  background: rgba(255, 255, 255, 0.06);
}

/* 关键词标签可点击触发搜索 */
.kw-chip:active {
  background: rgba(232, 180, 75, 0.15);
  color: var(--gold);
}

.time {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--text-faint);
  margin-top: 6rpx;
}
