.mic-wrap {
  position: relative;
  width: 230rpx;
  height: 230rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.mic-core {
  width: 210rpx;
  height: 210rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #F0C05A, #D89A2B);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 44rpx rgba(232, 180, 75, 0.35);
  transition: transform 0.12s ease;
}

.mic-wrap:active .mic-core {
  transform: scale(0.94);
}

.mic-icon {
  font-size: 70rpx;
  line-height: 1;
}

.mic-tip {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #14161A;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 呼吸圆环 */
.ring {
  position: absolute;
  width: 230rpx;
  height: 230rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(232, 180, 75, 0.4);
  animation: pulse 2.2s ease-out infinite;
}
.ring-2 { animation-delay: 1.1s; }

@keyframes pulse {
  0% { transform: scale(1); opacity: 0.8; }
  100% { transform: scale(1.55); opacity: 0; }
}

/* 录音状态脉冲 */
.mic-wrap.recording .mic-core {
  animation: micPulse 1.2s ease-in-out infinite;
}
@keyframes micPulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(232, 180, 75, 0.55); }
  50% { box-shadow: 0 0 0 30rpx rgba(232, 180, 75, 0); }
}

.mic-wrap.disabled { opacity: 0.5; }
